# Copy this file to .env on the control-plane VM.
# TEST VALUES ONLY: do not expose this setup to an untrusted network.
COMPOSE_PROJECT_NAME=aegis-vbox

# Local test database
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=aegis-vbox-test-db-password
POSTGRES_DB=aegis_db

# Local test admin; change before using outside an isolated test network.
SECRET_KEY=virtualbox-test-secret-key-change-before-real-deployment-32bytes
ADMIN_INITIAL_PASSWORD=AegisLab2026!
